# BackNine Insurance (back9ins.com)
# Note: BackNine uses embedded Quote & Apply widgets and the BOSS platform.
# API integration may require partnership agreement with BackNine.
BACKN9NE_API_KEY=your_backn9ne_api_key_here
BACKN9NE_API_URL=https://api.back9ins.com/v1
BACKN9NE_AGENT_ID=your_agent_id_here

# Altruist RIA Custodial Platform
# Docs: https://developer.altruist.com
# Auth: OAuth 2.0 — request credentials at developer.altruist.com
# Sandbox URL: https://openapi.stage1.altruistnet.tech/altruist-open-api/
# Production URL: https://openapi.altruist.com/altruist-open-api/
ALTRUIST_API_KEY=your_altruist_oauth_token_here
ALTRUIST_API_URL=https://openapi.altruist.com/altruist-open-api
ALTRUIST_ADVISOR_ID=your_advisor_id_here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
